# Copy this file to .env and fill in your values.
# .env is excluded from the repo via .gitignore.

# The full Developer ID Application identity string.
# Find yours with: security find-identity -v -p codesigning
DEVELOPER_ID=Developer ID Application: Your Name (TEAMID)

# Apple ID used for notarization (your Apple developer account email).
APPLE_ID=you@example.com

# App-specific password for notarytool.
# Generate one at: https://appleid.apple.com > App-Specific Passwords
APPLE_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Your Apple Developer Team ID.
# Find yours at: https://developer.apple.com/account > Membership
TEAM_ID=XXXXXXXXXX
